// ---------- PROGRAMACIÓN HORARIA (también silenciosa) ----------
function cargarHorariosGuardados() {
    const saved = localStorage.getItem(HORARIOS_STORAGE_KEY);
    if(saved) {
        try {
            const parsed = JSON.parse(saved);
            for(let key in gruposPorHorario) {
                if(parsed[key]) {
                    gruposPorHorario[key].enabled = parsed[key].enabled !== undefined ? parsed[key].enabled : gruposPorHorario[key].enabled;
                    gruposPorHorario[key].start = parsed[key].start || gruposPorHorario[key].start;
                    gruposPorHorario[key].end = parsed[key].end || gruposPorHorario[key].end;
                }
            }
        } catch(e) {}
    }
}

function guardarHorarios() {
    for(let key in gruposPorHorario) {
        const enabledCheck = document.getElementById(`schedule-${key}-enabled`);
        const startInput = document.getElementById(`schedule-${key}-start`);
        const endInput = document.getElementById(`schedule-${key}-end`);
        if(enabledCheck) gruposPorHorario[key].enabled = enabledCheck.checked;
        if(startInput) gruposPorHorario[key].start = startInput.value;
        if(endInput) gruposPorHorario[key].end = endInput.value;
    }
    localStorage.setItem(HORARIOS_STORAGE_KEY, JSON.stringify({
        manana: { enabled: gruposPorHorario.manana.enabled, start: gruposPorHorario.manana.start, end: gruposPorHorario.manana.end },
        tarde: { enabled: gruposPorHorario.tarde.enabled, start: gruposPorHorario.tarde.start, end: gruposPorHorario.tarde.end },
        noche: { enabled: gruposPorHorario.noche.enabled, start: gruposPorHorario.noche.start, end: gruposPorHorario.noche.end }
    }));
    toast('Horarios guardados');
    log('Configuración de horarios actualizada', 'log-success');
}

function renderizarHorariosEnUI() {
    const container = document.getElementById('schedule-list');
    if(!container) return;
    container.innerHTML = '';
    const orden = ['manana','tarde','noche'];
    for(let key of orden) {
        const h = gruposPorHorario[key];
        const div = document.createElement('div');
        div.className = 'schedule-item';
        div.innerHTML = `
            <label style="display:flex; align-items:center; gap:0.5rem;">
                <input type="checkbox" id="schedule-${key}-enabled" ${h.enabled ? 'checked' : ''}>
                <strong style="color:var(--accent);">${h.name}</strong>
            </label>
            <div class="schedule-time">
                <span>Desde:</span> <input type="time" id="schedule-${key}-start" value="${h.start}" step="60">
                <span>Hasta:</span> <input type="time" id="schedule-${key}-end" value="${h.end}" step="60">
            </div>
            <div class="schedule-groups">📌 ${h.groups.length} grupos asignados</div>
        `;
        container.appendChild(div);
    }
}

function iniciarScheduler() {
    if(schedulerInterval) clearInterval(schedulerInterval);
    schedulerInterval = setInterval(() => {
        const ahora = new Date();
        const horaActual = `${String(ahora.getHours()).padStart(2,'0')}:${String(ahora.getMinutes()).padStart(2,'0')}`;
        if(localStorage.getItem('sp_bot_active') === 'true') return;
        for(let key in gruposPorHorario) {
            const franja = gruposPorHorario[key];
            if(!franja.enabled) continue;
            if(horaActual >= franja.start && horaActual <= franja.end) {
                const hoyStr = ahora.toISOString().slice(0,10);
                const lastRunKey = `sp_lastrun_${key}`;
                if(localStorage.getItem(lastRunKey) === hoyStr) continue;
                log(`🕒 Franja horaria activada: ${franja.name} (${franja.start}-${franja.end})`, 'log-info');
                const cola = franja.groups.map(g => g.url);
                if(cola.length === 0) { log(`No hay grupos para ${franja.name}`, 'log-warn'); continue; }
                localStorage.setItem('sp_queue', JSON.stringify(cola));
                localStorage.setItem('sp_bot_active', 'true');
                localStorage.setItem('sp_idx', '0');
                localStorage.setItem(lastRunKey, hoyStr);
                document.getElementById('btn-play').style.display='none';
                document.getElementById('btn-pause').style.display='block';
                document.getElementById('eq-anim').classList.add('active');
                document.getElementById('motor-status').innerHTML='<span class="dot green"></span>TRANSMITIENDO';
                document.getElementById('motor-status').className='value status-running';
                solicitarWakeLock();
                log(`📌 Primer grupo automático: ${cola[0]} - Ábrelo manualmente`, 'log-warn');
                if(pollingInterval) clearInterval(pollingInterval);
                pollingInterval = setInterval(()=>{
                    const idxGuardado = parseInt(localStorage.getItem('sp_idx')||'0');
                    const colaActual = JSON.parse(localStorage.getItem('sp_queue')||'[]');
                    if(colaActual.length === 0 || localStorage.getItem('sp_bot_active')!=='true') {
                        clearInterval(pollingInterval);
                        pollingInterval = null;
                        detenerMotor();
                        log(`✅ Franja ${franja.name} completada`, 'log-success');
                    }
                }, 4000);
                break;
            }
        }
    }, 60000);
}

// ---------- ADMIN (CLAVES) ----------
function generarClaveCliente() {
    const nombre = document.getElementById('client-name-input').value.trim();
    if(!nombre) { toast('Escribe nombre'); return; }
    const clave = generarClave(nombre);
    const ahora = new Date();
    const vence = new Date(ahora.getFullYear(), ahora.getMonth()+1, ahora.getDate());
    clientKeys[clave] = { nombre, telefonos:1, vence: vence.toLocaleDateString('es-MX'), generado: ahora.toLocaleDateString('es-MX') };
    localStorage.setItem('sp_keys', JSON.stringify(clientKeys));
    renderizarTablaClaves();
    document.getElementById('client-name-input').value = '';
    navigator.clipboard.writeText(clave).catch(()=>{});
    toast(`Clave: ${clave} (copiada)`);
}
function revocarClave(clave) { if(!confirm(`¿Revocar ${clave}?`)) return; delete clientKeys[clave]; localStorage.setItem('sp_keys',JSON.stringify(clientKeys)); renderizarTablaClaves(); toast('Revocada'); }
function renderizarTablaClaves() {
    const tbody = document.getElementById('keys-tbody');
    tbody.innerHTML = '';
    const entradas = Object.entries(clientKeys);
    if(entradas.length===0) { tbody.innerHTML='<tr><td colspan="5" style="text-align:center;">Sin claves生成</td></tr>'; return; }
    entradas.forEach(([clave, info])=>{
        const match = clave.match(/SP-([A-Z0-9]+)(\d{2})(\d{2})$/);
        const mes = match ? parseInt(match[2]) : 0, anio = match ? parseInt('20'+match[3]) : 0;
        const ahora = new Date();
        const vencida = (anio < ahora.getFullYear()) || (anio===ahora.getFullYear() && mes < ahora.getMonth()+1);
        tbody.innerHTML += `<tr><td>${info.nombre}</td><td class="key-val">${clave}</td><td class="key-exp ${vencida?'expired':''}">${info.vence}${vencida?' ✕':''}</td><td style="text-align:center;">${info.telefonos}</td></td><button class="btn-revoke" onclick="revocarClave('${clave}')">Revocar</button> </tr>`;
    });
}

function cerrarSesion() { detenerMotor(); if(schedulerInterval) clearInterval(schedulerInterval); localStorage.removeItem('sp_auth'); localStorage.removeItem('sp_role'); window.location.reload(); }

