// ---------- UTILIDADES ----------
function toast(msg, dur=2500) {
    const el = document.getElementById('toast');
    el.textContent = msg;
    el.classList.add('show');
    setTimeout(() => el.classList.remove('show'), dur);
}

function log(msg, cls='') {
    const box = document.getElementById('system-logs');
    const time = new Date().toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
    box.innerHTML += `<span class="${cls}">[${time}] ${msg}</span><br>`;
    box.scrollTop = box.scrollHeight;
}

function obtenerHuella() { return btoa(navigator.userAgent).substring(8,20).toLowerCase(); }

// ---------- LICENCIA ----------
function generarClave(nombre) {
    const ahora = new Date();
    const mes = String(ahora.getMonth()+1).padStart(2,'0');
    const anio = String(ahora.getFullYear()).slice(-2);
    let hash = 0;
    for (let i=0; i<nombre.length; i++) hash = ((hash<<5)-hash+nombre.charCodeAt(i))&0xffffffff;
    const hashStr = Math.abs(hash).toString(36).toUpperCase().padStart(4,'0').slice(0,4);
    return `SP-${hashStr}${mes}${anio}`;
}

function verificarClave(clave) {
    if (!clave) return null;
    if (clave===ADMIN_KEY || clave===LEGACY_KEY) return { role:'admin', telefonos:4 };
    const match = clave.match(/^SP-([A-Z0-9]{4})(\d{2})(\d{2})$/);
    if (!match) return null;
    const mesClave = parseInt(match[2]), anioClave = parseInt('20'+match[3]);
    const ahora = new Date();
    const mesActual = ahora.getMonth()+1, anioActual = ahora.getFullYear();
    const valida = (anioClave===anioActual && mesClave===mesActual) ||
                   (anioClave===anioActual && mesClave===mesActual-1) ||
                   (anioActual===anioClave+1 && mesClave===12 && mesActual===1);
    if (!valida) return null;
    const datos = clientKeys[clave];
    return { role:'client', telefonos: datos ? datos.telefonos : 1 };
}

// ---------- LOGIN ----------
function verificarAcceso() {
    const clave = document.getElementById('access-key').value.trim();
    const resultado = verificarClave(clave);
    if (!resultado) { document.getElementById('login-error').style.display='block'; return; }
    currentRole = resultado.role;
    currentPlan = { telefonos: resultado.telefonos };
    localStorage.setItem('sp_auth', clave);
    localStorage.setItem('sp_role', resultado.role);
    currentIndex = parseInt(localStorage.getItem('sp_idx') || '0');
    clientKeys = JSON.parse(localStorage.getItem('sp_keys') || '{}');
    cargarHorariosGuardados();
    iniciarDashboard();
}

function iniciarDashboard() {
    document.getElementById('login-screen').style.display='none';
    document.getElementById('dashboard').style.display='flex';
    document.getElementById('device-id').textContent = obtenerHuella();
    if (currentRole === 'admin') {
        document.getElementById('role-badge').textContent = '⚙ ADMIN';
        document.getElementById('role-badge').className = 'badge badge-admin';
        document.getElementById('admin-panel').style.display = 'block';
        renderizarTablaClaves();
    } else {
        document.getElementById('role-badge').textContent = '✦ ACTIVO';
        document.getElementById('role-badge').className = 'badge badge-user';
    }
    renderizarTelefonos();
    cargarGaleriaDesdeStorage();
    renderizarHorariosEnUI();
    cambiarZona();
    iniciarScheduler();
}

// ---------- TELÉFONOS ----------
function renderizarTelefonos() {
    const grid = document.getElementById('phones-grid');
    const total = currentPlan.telefonos;
    const saved = JSON.parse(localStorage.getItem('sp_phones') || '[]');
    grid.innerHTML = '';
    for (let i=0; i<total; i++) {
        const col = i%2===0 ? 'var(--accent)' : 'var(--gold)';
        const val = saved[i] || '';
        grid.innerHTML += `<div class="phone-field"><span class="phone-label">WhatsApp ${i+1}</span><input type="tel" id="tel-${i}" class="phone-input" style="color:${col}" placeholder="52442XXXXXXX" value="${val}" onchange="guardarTelefonos()"></div>`;
    }
    grid.style.display = total>=1 ? 'grid' : 'none';
    grid.style.gridTemplateColumns = total===1 ? '1fr' : '1fr 1fr';
}
function guardarTelefonos() {
    const total = currentPlan.telefonos;
    const phones = [];
    for (let i=0; i<total; i++) { const el = document.getElementById(`tel-${i}`); phones.push(el ? el.value.trim() : ''); }
    localStorage.setItem('sp_phones', JSON.stringify(phones));
}
function obtenerTelefonos() {
    const total = currentPlan.telefonos;
    const phones = [];
    for (let i=0; i<total; i++) { const el = document.getElementById(`tel-${i}`); if(el && el.value.trim()) phones.push(el.value.trim()); }
    return phones;
}

// ---------- IA + MANUAL ----------
async function generarVariacionesIA() {
    const idea = document.getElementById('base-prompt').value.trim();
    if (!idea) { toast('Escribe oferta base.'); return; }
    const telefonos = obtenerTelefonos();
    if (!telefonos.length) { toast('Agrega al menos un WhatsApp.'); return; }
    const out = document.getElementById('ai-outputs');
    const btn = document.getElementById('btn-generate');
    out.innerHTML = '<div style="font-size:.75rem;color:var(--accent);">▌ Invocando IA...</div>';
    btn.disabled = true;
    try {
        const res = await fetch('/api/generate-variations', {
            method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({ idea, telefonos })
        });
        if(!res.ok) throw new Error('Error IA');
        const data = await res.json();
        const variaciones = data.variaciones || [];
        if(!variaciones.length) throw new Error('Sin variaciones');
        mostrarVariaciones(variaciones);
        localStorage.setItem('sp_copies', JSON.stringify(variaciones));
        toast('✦ Variaciones generadas');
    } catch(err) {
        out.innerHTML = `<div style="font-size:.75rem;color:var(--red);">⚠ ${err.message}. Usa modo manual.</div>`;
        log(`Error IA: ${err.message}`, 'log-error');
    } finally { btn.disabled = false; }
}

function guardarVariacionesManuales() {
    const v1 = document.getElementById('manual-var-1').value.trim();
    const v2 = document.getElementById('manual-var-2').value.trim();
    const v3 = document.getElementById('manual-var-3').value.trim();
    if(!v1||!v2||!v3) { toast('Completa las 3 variaciones'); return; }
    const variaciones = [v1,v2,v3];
    mostrarVariaciones(variaciones);
    localStorage.setItem('sp_copies', JSON.stringify(variaciones));
    toast('✅ Manuales guardadas');
}

function mostrarVariaciones(variaciones) {
    const out = document.getElementById('ai-outputs');
    out.innerHTML = '';
    variaciones.forEach((v,i) => {
        out.innerHTML += `<div class="variation-card"><span class="variation-num">VARIACIÓN ${i+1}</span><button class="btn-copy-var" onclick="copiarVariacion(${i})">Copiar</button><div id="var-text-${i}">${escapeHtml(v)}</div></div>`;
    });
}
function escapeHtml(str) { return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>'); }
async function copiarVariacion(idx) { const el=document.getElementById(`var-text-${idx}`); if(!el) return; try{ await navigator.clipboard.writeText(el.innerText); toast('✓ Copiado'); } catch{ toast('Selecciona manual'); } }

// ---------- GALERÍA ----------
function onGaleriaCargada() {
    const input = document.getElementById('gallery-input');
    if(!input.files.length) return;
    const filesArray = Array.from(input.files);
    const imagesData = [];
    let processed=0;
    filesArray.forEach(file=>{
        const reader = new FileReader();
        reader.onload = (e)=>{
            imagesData.push({ name: file.name, dataURL: e.target.result });
            processed++;
            if(processed===filesArray.length) {
                localStorage.setItem('sp_gallery', JSON.stringify(imagesData));
                cargarGaleriaDesdeStorage();
                toast(`${imagesData.length} imágenes guardadas`);
                log(`Galería: ${imagesData.length} imágenes`, 'log-info');
            }
        };
        reader.readAsDataURL(file);
    });
}
function cargarGaleriaDesdeStorage() {
    const stored = localStorage.getItem('sp_gallery');
    if(!stored) return;
    const images = JSON.parse(stored);
    const previewDiv = document.getElementById('gallery-preview');
    previewDiv.innerHTML = '';
    images.forEach((img,idx)=>{
        const thumb = document.createElement('img');
        thumb.src = img.dataURL;
        thumb.className = 'thumb';
        thumb.onclick = () => verFlyerConcreto(idx);
        previewDiv.appendChild(thumb);
    });
}
function verFlyerConcreto(idx) {
    const stored = localStorage.getItem('sp_gallery');
    if(!stored) return;
    const images = JSON.parse(stored);
    if(images[idx]) { document.getElementById('flyer-img').src = images[idx].dataURL; document.getElementById('flyer-modal').classList.add('open'); }
}
function cerrarFlyerModal() { document.getElementById('flyer-modal').classList.remove('open'); }

// ---------- GRUPOS ----------
function obtenerGruposZona(zona) {
    if(zona === 'all') {
        let todos = [];
        for(let key in gruposPorHorario) todos = todos.concat(gruposPorHorario[key].groups);
        return todos;
    }
    return gruposPorHorario[zona]?.groups || [];
}

function cambiarZona() {
    const zona = document.getElementById('zona-select').value;
    const grupos = obtenerGruposZona(zona);
    const cont = document.getElementById('groups-container');
    cont.innerHTML = '';
    grupos.forEach((g,i) => {
        cont.innerHTML += `<label id="gr-${i}" class="group-row"><span class="group-name-text">${g.name}</span><input type="checkbox" checked value="${g.url}" class="sp-group"></label>`;
    });
    actualizarUI();
}

function actualizarUI() {
    const checkboxes = document.querySelectorAll('.sp-group');
    const total = checkboxes.length;
    document.getElementById('tot-idx').textContent = total;
    document.getElementById('cur-idx').textContent = Math.min(currentIndex, total);
    const pct = total>0 ? Math.round((currentIndex/total)*100) : 0;
    document.getElementById('track-pct').textContent = `${pct}%`;
    document.getElementById('progress-fill').style.width = `${pct}%`;
    checkboxes.forEach((_,idx)=>{
        const row = document.getElementById(`gr-${idx}`);
        if(!row) return;
        if(idx===currentIndex && total>0) {
            row.classList.add('active');
            document.getElementById('track-name').textContent = row.querySelector('.group-name-text').textContent;
            row.scrollIntoView({ block:'nearest', behavior:'smooth' });
        } else row.classList.remove('active');
    });
}

// ---------- WAKELOCK ----------
async function solicitarWakeLock() { if('wakeLock' in navigator) { try { wakeLock = await navigator.wakeLock.request('screen'); document.getElementById('wl-status-text').textContent='Activo'; document.getElementById('wl-status-text').style.color='var(--accent)'; document.getElementById('wakelock-badge').textContent='⚡'; } catch(e){} } }
function liberarWakeLock() { if(wakeLock){ wakeLock.release(); wakeLock=null; } document.getElementById('wl-status-text').textContent='Inactivo'; document.getElementById('wl-status-text').style.color='var(--text-3)'; document.getElementById('wakelock-badge').textContent='🔒'; }

// ---------- MOTOR MANUAL (SILENCIOSO, SIN ABRIR PESTAÑA) ----------
function construirCola() { return Array.from(document.querySelectorAll('.sp-group:checked')).slice(currentIndex).map(cb=>cb.value); }

function lanzarMotor() {
    const copies = localStorage.getItem('sp_copies');
    if(!copies || JSON.parse(copies).length===0) { toast('Genera variaciones (IA o manual)'); return; }
    const cola = construirCola();
    if(cola.length===0) { toast('No hay grupos pendientes'); return; }
    localStorage.setItem('sp_queue', JSON.stringify(cola));
    localStorage.setItem('sp_bot_active','true');
    localStorage.setItem('sp_idx', String(currentIndex));
    document.getElementById('btn-play').style.display='none';
    document.getElementById('btn-pause').style.display='block';
    document.getElementById('eq-anim').classList.add('active');
    document.getElementById('motor-status').innerHTML='<span class="dot green"></span>TRANSMITIENDO';
    document.getElementById('motor-status').className='value status-running';
    solicitarWakeLock();
    log(`▶ Motor silencioso activado. Cola: ${cola.length} grupos.`, 'log-info');
    log(`📌 Primer grupo: ${cola[0]} - Ábrelo manualmente en otra pestaña (o Tampermonkey lo hará)`, 'log-warn');
    // NO abrimos ventana automática
    if(pollingInterval) clearInterval(pollingInterval);
    pollingInterval = setInterval(()=>{
        const idxGuardado = parseInt(localStorage.getItem('sp_idx')||'0');
        if(idxGuardado !== currentIndex) {
            currentIndex = idxGuardado;
            actualizarUI();
            const colaActual = JSON.parse(localStorage.getItem('sp_queue')||'[]');
            log(`✓ Publicado en grupo #${currentIndex}`, 'log-success');
            if(colaActual.length===0 || localStorage.getItem('sp_bot_active')!=='true') {
                log('🏁 Cola completada.', 'log-info');
                detenerMotor();
                currentIndex=0; localStorage.setItem('sp_idx','0'); actualizarUI();
            }
        }
    }, 4000);
}

function detenerMotor() {
    if(pollingInterval) clearInterval(pollingInterval);
    localStorage.setItem('sp_bot_active','false');
    document.getElementById('btn-play').style.display='block';
    document.getElementById('btn-pause').style.display='none';
    document.getElementById('eq-anim').classList.remove('active');
    document.getElementById('motor-status').innerHTML='<span class="dot amber"></span>EN PAUSA';
    document.getElementById('motor-status').className='value status-paused';
    liberarWakeLock();
    log('⏸ Motor pausado', 'log-warn');
}

function saltarGrupo(dir) {
    const total = document.querySelectorAll('.sp-group').length;
    if(total===0) return;
    currentIndex = Math.max(0, Math.min(total-1, currentIndex+dir));
    localStorage.setItem('sp_idx', currentIndex);
    actualizarUI();
    log(`Salto manual → grupo #${currentIndex+1}`);
}

